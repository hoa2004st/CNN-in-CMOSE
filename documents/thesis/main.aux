\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text  {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups.}}{21}{figure.caption.15}\protected@file@percent }
\newlabel{fig:group_encoders}{{3.4}{21}{The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups}{figure.caption.15}{}}
