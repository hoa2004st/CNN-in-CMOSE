\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Semantic-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector.}}{19}{figure.caption.14}\protected@file@percent }
\newlabel{fig:hybrid}{{3.3}{19}{Semantic-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector}{figure.caption.14}{}}
\newlabel{fig:ge_tcn}{{3.4a}{20}{TCN group encoder}{figure.caption.15}{}}
\newlabel{sub@fig:ge_tcn}{{a}{20}{TCN group encoder}{figure.caption.15}{}}
\newlabel{fig:ge_transformer}{{3.4b}{20}{Transformer group encoder}{figure.caption.15}{}}
\newlabel{sub@fig:ge_transformer}{{b}{20}{Transformer group encoder}{figure.caption.15}{}}
\newlabel{fig:ge_lstm}{{3.4c}{20}{LSTM group encoder}{figure.caption.15}{}}
\newlabel{sub@fig:ge_lstm}{{c}{20}{LSTM group encoder}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text  {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups.}}{20}{figure.caption.15}\protected@file@percent }
\newlabel{fig:group_encoders}{{3.4}{20}{The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups}{figure.caption.15}{}}
