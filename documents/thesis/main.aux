\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Semantic-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector.}}{20}{figure.caption.14}\protected@file@percent }
\newlabel{fig:hybrid}{{3.3}{20}{Semantic-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector}{figure.caption.14}{}}
\newlabel{fig:ge_tcn}{{3.4a}{21}{TCN group encoder}{figure.caption.15}{}}
\newlabel{sub@fig:ge_tcn}{{a}{21}{TCN group encoder}{figure.caption.15}{}}
\newlabel{fig:ge_transformer}{{3.4b}{21}{Transformer group encoder}{figure.caption.15}{}}
