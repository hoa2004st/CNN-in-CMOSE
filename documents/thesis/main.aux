\newlabel{sub@fig:ge_lstm}{{c}{22}{LSTM group encoder}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text  {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups.}}{22}{figure.caption.20}\protected@file@percent }
\newlabel{fig:group_encoders}{{3.9}{22}{The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups}{figure.caption.20}{}}
