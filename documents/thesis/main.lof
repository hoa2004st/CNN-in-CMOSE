\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces The residual TemporalBlock used in every TCN of this thesis: two weight-normalised dilated causal 1-D convolutions, each followed by a ReLU and dropout, summed with a residual connection (kernel size~3).}}{10}{figure.caption.8}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces A single LSTM cell at time step $t$: the forget, input, and output gates regulate how the cell state $C_t$ and hidden state $h_t$ are updated from the previous states $C_{t-1}$, $h_{t-1}$ and the input $x_t$.}}{11}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Engagement class distribution by dataset.}}{16}{figure.caption.11}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Class distribution by split, per dataset.}}{17}{figure.caption.12}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Baseline \texttt {openface\_mlp}: the full $T\times 709$ OpenFace sequence is flattened and classified by a multilayer perceptron.}}{19}{figure.caption.13}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Baseline \texttt {openface\_tcn}: a temporal convolutional network over the full 709-d sequence, adaptively average-pooled and classified.}}{19}{figure.caption.14}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Baseline \texttt {openface\_lstm}: a two-layer LSTM over the full 709-d sequence whose final state is classified.}}{19}{figure.caption.15}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Baseline \texttt {openface\_transformer}: a Transformer encoder over the full 709-d sequence with sinusoidal positional encoding, mean-pooled and classified.}}{19}{figure.caption.16}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Baseline \texttt {i3d\_mlp}: the pooled 1024-d I3D clip vector is classified by a multilayer perceptron.}}{20}{figure.caption.17}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Semantic-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector.}}{21}{figure.caption.19}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups.}}{22}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Rank agreement (Kendall $\tau $) between the six metrics over the fifteen baseline configurations, in-domain on CMOSE (the MAE metrics are sign-flipped so that positive $\tau $ always means agreement on which models are better). The metrics form a micro block and a macro block that barely agree with each other; QWK is the only metric correlated with both.}}{27}{figure.caption.22}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces In-domain ordinal signal: CMOSE versus DAiSEE.}}{28}{figure.caption.24}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces What each loss trades: the three primary metrics for every baseline across the three losses, in-domain on CMOSE. Macro-accuracy and macro-MAE improve as the loss is rebalanced, while QWK is generally highest under cross-entropy.}}{29}{figure.caption.25}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Two faces of the loss trade-off in the primary metrics, in-domain on CMOSE: the balanced losses move each model toward better balance on both the recall axis (macro-accuracy) and the ordinal-distance axis (macro-MAE), at the cost of QWK.}}{29}{figure.caption.26}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Representative training/validation loss curves (CMOSE, cross-entropy).}}{30}{figure.caption.27}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces The five base models under the three losses on all six metrics, in-domain on CMOSE. The metrics disagree on the winner: accuracy, MAE, and Cohen's kappa favour the I3D MLP under cross-entropy, QWK favours the OpenFace TCN, and the macro metrics peak under the balanced losses.}}{31}{figure.caption.28}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Pairwise prediction agreement (Cohen's $\kappa $) between all fifteen baseline configurations on the in-domain CMOSE test set, in model-major blocks. The diagonal blocks are the same architecture under different losses; agreement is moderate at best everywhere.}}{33}{figure.caption.30}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Best OpenFace encoder (the TCN) versus the I3D MLP on the three primary metrics, in-domain on CMOSE under cross-entropy: OpenFace wins all three.}}{35}{figure.caption.32}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Error overlap between the OpenFace TCN and every other architecture (all under cross-entropy, in-domain CMOSE): the share of test clips both classify correctly, only one classifies correctly, or both miss. The I3D MLP has the largest exclusive-correct share and the smallest both-wrong share --- the two feature families fail on different clips.}}{35}{figure.caption.33}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Cross-domain generalisation, best base model per cell, on the three primary metrics --- QWK, macro-accuracy, and macro-MAE (lower is better) --- plus raw accuracy, the deceptive foil: accuracy stays high in exactly the off-diagonal cells where every chance-corrected metric collapses.}}{36}{figure.caption.34}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Architecture ranking in-domain versus on the unseen-target cells (best loss per cell). The in-domain order does not survive the shift: the I3D MLP drops from second to fourth, while the OpenFace encoders hold their relative positions.}}{37}{figure.caption.35}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Loss ranking in-domain versus on the unseen-target cells (best architecture per cell): cross-entropy is best in both regimes --- the only factor ranking that survives the shift.}}{39}{figure.caption.36}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces In-domain QWK versus mean QWK on the unseen-target cells, one point per trained baseline configuration (circles: CMOSE-trained; triangles: DAiSEE-trained; colour: architecture). The correlation is weak ($\rho =0.28$): in-domain strength barely predicts transfer.}}{39}{figure.caption.37}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Hybrid ablation across all 243 per-group encoder configurations, with and without I3D, on all six metrics (in-domain CMOSE). Each dashed line is the best base model on that metric, across all three losses.}}{42}{figure.caption.38}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Rank agreement (Kendall $\tau $) between the six metrics over the 486 hybrid configurations, in-domain on CMOSE: the same two-block structure as for the baselines (Figure~\ref {fig:metric_correlation_base}), with QWK again the only bridging metric.}}{43}{figure.caption.39}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Per-group marginal effect of the encoder choice on in-domain QWK.}}{44}{figure.caption.41}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces The same per-group marginal computed over the unseen-target cells: head pose again shows the largest spread and again prefers the TCN, so the in-domain preference is not corpus-specific.}}{45}{figure.caption.43}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Paired effect of I3D fusion: $\Delta $QWK between each configuration with and without the I3D stream (same per-group encoders), by evaluation regime. Fusion is decisively positive where the test corpus was seen in training, mildly negative cross-corpus, and neutral with high variance on the private set.}}{46}{figure.caption.44}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Best hybrid versus best base model, in-domain on CMOSE.}}{47}{figure.caption.46}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Confusion matrices of the best base versus the best hybrid (in-domain, row-normalised).}}{48}{figure.caption.47}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Per-class F1: best base versus best hybrid.}}{48}{figure.caption.48}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Cross-domain generalisation, best hybrid per cell, on the three primary metrics --- QWK, macro-accuracy, and macro-MAE (lower is better) --- plus raw accuracy, which again stays high in the off-diagonal cells where the chance-corrected metrics collapse.}}{49}{figure.caption.49}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Private-set generalisation by training source: best base versus best hybrid, on QWK (higher is better) --- the headline generalisation metric. Macro-accuracy and macro-MAE for the same models are in Table~\ref {tab:T6_private_by_source}.}}{51}{figure.caption.51}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Private-set confusion, combined-trained I3D hybrid \texttt {T\_T\_T\_LSTM\_T} (QWK 0.379, macro-MAE 0.877), row-normalised.}}{52}{figure.caption.52}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces In-domain QWK versus mean unseen-target QWK with the hybrid ablation population (grey) overlaid on the baseline configurations (coloured). Within the hybrid family the correlation is negative ($\rho =-0.31$): more in-domain fit means more corpus fit. The hybrid cloud sits above the baselines throughout --- the architecture lifts the trade-off rather than riding it.}}{53}{figure.caption.53}%
