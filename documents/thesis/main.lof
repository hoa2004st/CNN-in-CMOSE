\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces The residual TemporalBlock used in every TCN of this thesis: two weight-normalised dilated causal 1-D convolutions, each followed by a ReLU and dropout, summed with a residual connection (kernel size~3).}}{10}{figure.caption.8}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces A single LSTM cell at time step $t$: the forget, input, and output gates regulate how the cell state $C_t$ and hidden state $h_t$ are updated from the previous states $C_{t-1}$, $h_{t-1}$ and the input $x_t$.}}{11}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Engagement class distribution by dataset.}}{16}{figure.caption.11}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Class distribution by split, per dataset.}}{17}{figure.caption.12}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Baseline \texttt {openface\_mlp}: the full $T\times 709$ OpenFace sequence is flattened and classified by a multilayer perceptron.}}{19}{figure.caption.13}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Baseline \texttt {openface\_tcn}: a temporal convolutional network over the full 709-d sequence, adaptively average-pooled and classified.}}{19}{figure.caption.14}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Baseline \texttt {openface\_lstm}: a two-layer LSTM over the full 709-d sequence whose final state is classified.}}{19}{figure.caption.15}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Baseline \texttt {openface\_transformer}: a Transformer encoder over the full 709-d sequence with sinusoidal positional encoding, mean-pooled and classified.}}{19}{figure.caption.16}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Baseline \texttt {i3d\_mlp}: the pooled 1024-d I3D clip vector is classified by a multilayer perceptron.}}{20}{figure.caption.17}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Semantic-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector.}}{21}{figure.caption.19}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups.}}{22}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces The five base models under the three losses on all six metrics, in-domain on CMOSE. The metrics disagree on the winner: accuracy, MAE, and Cohen's kappa favour the I3D MLP under cross-entropy, QWK favours the OpenFace TCN, and the macro metrics peak under the balanced losses.}}{26}{figure.caption.21}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Best OpenFace encoder (the TCN) versus the I3D MLP on the three primary metrics, in-domain on CMOSE under cross-entropy: OpenFace wins all three.}}{28}{figure.caption.23}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces What each loss trades: the three primary metrics for every baseline across the three losses, in-domain on CMOSE. Macro-accuracy and macro-MAE improve as the loss is rebalanced, while QWK is generally highest under cross-entropy.}}{29}{figure.caption.24}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Two faces of the loss trade-off in the primary metrics, in-domain on CMOSE: the balanced losses move each model toward better balance on both the recall axis (macro-accuracy) and the ordinal-distance axis (macro-MAE), at the cost of QWK.}}{30}{figure.caption.25}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Representative training/validation loss curves (CMOSE, cross-entropy).}}{30}{figure.caption.26}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces In-domain ordinal signal: CMOSE versus DAiSEE.}}{31}{figure.caption.28}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Cross-domain generalisation, best base model per cell, on the three primary metrics: QWK, macro-accuracy, and macro-MAE (lower is better).}}{32}{figure.caption.29}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Hybrid ablation across all 243 per-group encoder configurations, with and without I3D, on all six metrics (in-domain CMOSE). Each dashed line is the best base model on that metric, across all three losses.}}{36}{figure.caption.31}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Per-group marginal effect of the encoder choice on in-domain QWK.}}{38}{figure.caption.34}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Best hybrid versus best base model, in-domain on CMOSE.}}{39}{figure.caption.35}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Confusion matrices of the best base versus the best hybrid (in-domain, row-normalised).}}{40}{figure.caption.36}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Per-class F1: best base versus best hybrid.}}{40}{figure.caption.37}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Cross-domain generalisation, best hybrid per cell, on the three primary metrics: QWK, macro-accuracy, and macro-MAE (lower is better).}}{41}{figure.caption.38}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Private-set generalisation by training source: best base versus best hybrid, on QWK (higher is better) --- the headline generalisation metric. Macro-accuracy and macro-MAE for the same models are in Table~\ref {tab:T6_private_by_source}.}}{42}{figure.caption.40}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Private-set confusion, combined-trained I3D hybrid \texttt {T\_T\_T\_LSTM\_T} (QWK 0.379, macro-MAE 0.877), row-normalised.}}{43}{figure.caption.41}%
