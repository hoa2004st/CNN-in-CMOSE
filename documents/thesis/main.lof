\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces The residual TemporalBlock used in every TCN of this thesis: two weight-normalised dilated causal 1-D convolutions, each followed by a ReLU and dropout, summed with a residual connection (kernel size~3).}}{11}{figure.caption.8}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces A single LSTM cell at time step $t$: the forget, input, and output gates regulate how the cell state $C_t$ and hidden state $h_t$ are updated from the previous states $C_{t-1}$, $h_{t-1}$ and the input $x_t$.}}{12}{figure.caption.9}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces A single Transformer encoder layer used in this thesis: multi-head self-attention over the sinusoidally position-encoded input, followed by a position-wise feed-forward network, each sub-layer wrapped in a residual connection and layer normalisation.}}{13}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Engagement class distribution by dataset.}}{19}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces The five single-encoder baselines. Each applies a single encoder to the full feature sequence (or pooled I3D vector) before classification.}}{23}{figure.caption.13}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Feature-group hybrid architecture. Each OpenFace group is encoded independently into a 64-d embedding (group encoders are chosen per group from TCN / Transformer (T) / LSTM); the I3D clip vector is encoded by an MLP into a 128-d embedding. The six embeddings are concatenated (448-d) and classified by a shared MLP; each stream also feeds an auxiliary head. The OpenFace-only variant drops the I3D row and fuses a 320-d vector.}}{25}{figure.caption.15}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces The three interchangeable per-group encoders. Each maps a group's $T\times D_{\text {group}}$ sequence to a 64-dimensional embedding through temporal mean-pooling and layer normalisation; one is chosen independently for each of the five groups.}}{26}{figure.caption.16}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Rank agreement (Kendall $\tau $) between the six metrics over the fifteen baseline configurations, in-domain on CMOSE (MAE metrics sign-flipped so positive $\tau $ means agreement). The metrics form a micro block and a macro block that barely agree; QWK is the only metric correlated with both.}}{31}{figure.caption.18}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces What each loss trades: QWK (the selection metric) against the balanced secondary metrics (macro-accuracy and macro-MAE) for every baseline across the three losses, in-domain on CMOSE. Macro-accuracy and macro-MAE improve as the loss is rebalanced, while QWK is generally highest under cross-entropy.}}{32}{figure.caption.20}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces The five base models under the three losses on all six metrics, in-domain on CMOSE. The metrics disagree on the winner: accuracy, MAE, and Cohen's kappa favour the I3D MLP under cross-entropy, QWK favours the OpenFace TCN, and the macro metrics peak under the balanced losses.}}{33}{figure.caption.21}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Pairwise prediction agreement (Cohen's $\kappa $) between all fifteen baseline configurations on the in-domain CMOSE test set, in model-major blocks. The diagonal blocks are the same architecture under different losses; agreement is moderate at best everywhere.}}{34}{figure.caption.22}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Cross-domain generalisation, best base model per cell (selected by QWK), on QWK (the selection metric) and the balanced secondary metrics macro-accuracy and macro-MAE (lower is better), plus raw accuracy, the misleading one: accuracy stays high in exactly the off-diagonal cells where every chance-corrected metric collapses.}}{36}{figure.caption.24}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Hybrid ablation across all 243 per-group encoder configurations, with and without I3D, on all six metrics (in-domain CMOSE). The dashed line in every panel is the same model (the single QWK-selected baseline: OpenFace TCN, cross-entropy) read on that panel's metric, not a per-metric champion.}}{39}{figure.caption.25}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Cross-domain generalisation, best hybrid per cell (selected by QWK), on QWK (the selection metric) and the balanced secondary metrics macro-accuracy and macro-MAE (lower is better), plus raw accuracy, which again stays high in the off-diagonal cells where the chance-corrected metrics collapse.}}{42}{figure.caption.29}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Cell-by-cell hybrid advantage: best-hybrid minus best-base QWK over the 3$\times $3 train$\times $test matrix (Figure~\ref {fig:crossdomain_hybrid} minus Figure~\ref {fig:crossdomain_base}). Every cell is positive (the hybrid is strongest across the whole matrix), and the gain is largest on the unseen, self-collected Private column. The in-domain CMOSE cell and the Private column (bold) are the two comparisons read in Sections~\ref {sec:error} and~\ref {sec:private-results}.}}{43}{figure.caption.30}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Private-set confusion of the combined-trained best base model versus best hybrid (row-normalised).}}{45}{figure.caption.32}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Per-class F1 on the private set: combined-trained best base model versus best hybrid. The hybrid's out-of-domain gain concentrates on the engaged region and the middle Disengage class, while Highly-Disengage collapses to zero.}}{45}{figure.caption.33}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces In-domain QWK versus mean unseen-target QWK with the hybrid ablation population overlaid on the baseline configurations. Within the hybrid family the correlation is negative ($\rho =-0.31$): more in-domain fit means more dataset fit. The hybrid cloud lies above the baselines throughout: the architecture improves transfer at every level of in-domain performance.}}{46}{figure.caption.34}%
